VLAN_ID = 100
VLAN_NS = "vlan_test_ns"
VETH_HOST = "veth-vlan0"
VETH_NS = "veth-vlan1"
VLAN_NS_IP = "10.100.0.1"
VLAN_HOST_IP = "10.100.0.2"
VLAN_NETMASK = "255.255.255.0"


class TestApplyVlan(OnboardingMachineCase):
    """Test that VLAN configuration is correctly applied via NetworkManager.

    Creates a veth pair with one end in a network namespace. The namespace
    side has a VLAN subinterface acting as the peer. The wizard selects the
    host-side veth, enables VLAN, applies, and the test verifies the NM
    profile, subinterface, and connectivity through the VLAN.
    """

    def setUp(self):
        super().setUp()
        m = self.machine

        m.execute(
            f"ip link add {VETH_HOST} type veth"
            f" peer name {VETH_NS}"
        )

        m.execute(f"ip netns add {VLAN_NS}")
        m.execute(f"ip link set {VETH_NS} netns {VLAN_NS}")

        m.execute(f"ip netns exec {VLAN_NS} ip link set lo up")
        m.execute(f"ip netns exec {VLAN_NS} ip link set {VETH_NS} up")
        m.execute(
            f"ip netns exec {VLAN_NS} ip link add"
            f" link {VETH_NS} name {VETH_NS}.{VLAN_ID}"
            f" type vlan id {VLAN_ID}"
        )
        m.execute(
            f"ip netns exec {VLAN_NS} ip addr add"
            f" {VLAN_NS_IP}/24 dev {VETH_NS}.{VLAN_ID}"
        )
        m.execute(
            f"ip netns exec {VLAN_NS} ip link set"
            f" {VETH_NS}.{VLAN_ID} up"
        )

        m.execute(f"ip link set {VETH_HOST} up")
        m.execute(f"nmcli device set {VETH_HOST} managed yes")
        m.execute("udevadm settle")

        deadline = time.time() + 15
        while time.time() < deadline:
            state = m.execute(
                f"nmcli -g GENERAL.STATE device show {VETH_HOST}"
                " 2>/dev/null || echo waiting"
            ).strip()
            if state and "waiting" not in state:
                break
            time.sleep(1)
        else:
            raise Exception(
                f"NM did not recognize {VETH_HOST} within 15s"
            )

        config = {
            "version": "1.0",
            "runOnce": False,
            "hideModules": False,
            "network": {
                "ethernet": {
                    "enabled": False,
                }
            },
            "connectivityTest": {
                "host": VLAN_NS_IP,
            }
        }
        m.write(
            "/etc/cockpit/system-onboarding/config.json",
            json.dumps(config)
        )

        self.addCleanup(self._cleanup_vlan)

    def _cleanup_vlan(self):
        m = self.machine
        try:
            m.execute(
                "nmcli -t -f NAME connection show"
                " | grep flightctl-onboarding"
                " | xargs -r -n1 nmcli con delete 2>/dev/null || true"
            )
        except Exception:
            pass
        try:
            m.execute(
                f"ip netns pids {VLAN_NS} 2>/dev/null"
                " | xargs -r kill 2>/dev/null || true"
            )
            time.sleep(1)
            m.execute(f"ip netns delete {VLAN_NS} 2>/dev/null || true")
        except Exception:
            pass
        try:
            m.execute(f"ip link del {VETH_HOST} 2>/dev/null || true")
        except Exception:
            pass

    def testApplyVlanConfiguration(self):
        """Test that VLAN config creates correct NM profile and subinterface"""
        b = self.browser
        m = self.machine

        self.login_and_go(
            "/system-onboarding", user="onboarding", password="",
            superuser=False, tls=True,
        )

        b.wait_visible("#networkStep")
        b.wait_visible(IFACE_TABLE)

        row_sel = iface_row_selector(b, IFACE_TABLE, VETH_HOST)
        b.click(f"{row_sel} input[type='radio']")

        b.click("label[for='vlan-id']")
        b.wait_visible("input[type='text']#vlan-id-input")
        b.set_input_text("input[type='text']#vlan-id-input", str(VLAN_ID))

        b.click("#static-ip-radio")
        b.wait_visible("#ipv4-address")
        b.set_input_text("#ipv4-address", VLAN_HOST_IP)
        b.set_input_text("#subnet-mask", VLAN_NETMASK)
        b.set_input_text("#gateway-ip", VLAN_NS_IP)

        b.click("#manual-dns-ipv4-radio")
        b.wait_visible("#primary-dns-ipv4")
        b.set_input_text("#primary-dns-ipv4", VLAN_NS_IP)

        wait_next_enabled(b)
        click_button_text(b, "Next")
        b.wait_visible("#networkServicesStep")
        click_button_text(b, "Next")
        complete_enrollment_step(b)

        b.wait_visible("#labelsStep")
        b.wait_visible("#hostname-input")
        b.set_input_text("#hostname-input", "vlan-test-host")
        click_button_text(b, "Next")

        b.wait_visible("#reviewStep")
        b.wait_in_text("#review-network", str(VLAN_ID))

        b.click("#wizard-next-btn")
        b.wait_in_text("#progressStep", "Apply")

        with b.wait_timeout(120):
            b.wait_in_text(
                "#apply-success-alert",
                "Configuration completed successfully",
            )

        conn_name = f"flightctl-onboarding-{VETH_HOST}.{VLAN_ID}"
        conn = m.execute(f"nmcli -t connection show '{conn_name}'")
        self.assertIn("connection.type:vlan", conn)
        self.assertIn(f"vlan.id:{VLAN_ID}", conn)
        self.assertIn(f"vlan.parent:{VETH_HOST}", conn)

        m.execute(f"ip link show {VETH_HOST}.{VLAN_ID}")

        m.execute(
            f"ping -c 3 -I {VETH_HOST}.{VLAN_ID} {VLAN_NS_IP}",
            timeout=30,
        )


