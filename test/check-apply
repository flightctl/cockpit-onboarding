class TestApplySingleNicRollback(OnboardingMachineCase):
    """Test that single-NIC apply rolls back when connectivity fails.

    Forces a connectivity failure by setting connectivityTest.host to an
    unresolvable hostname. The apply-and-enroll.sh background script will
    activate the NM profile (DHCP, so the IP stays the same and SSH
    remains reachable), fail DNS resolution, and trigger its rollback
    trap — deleting the onboarding NM profiles and restoring the
    previous hostname.
    """

    def setUp(self):
        super().setUp()
        self.setup_iface = add_single_nic_interface(self)
        m = self.machine

        self.config = {
            "version": "1.0",
            "runOnce": False,
            "hideModules": False,
            "connectivityTest": {
                "host": "192.0.2.1",
                "connectivityTimeoutSeconds": 1,
            }
        }
        m.write(
            "/etc/cockpit/system-onboarding/config.json",
            json.dumps(self.config)
        )

    def testSingleNicRollbackOnConnectivityFailure(self):
        """Test that failed connectivity triggers rollback of NM profiles"""
        m = self.machine
        b = self.browser

        m.execute(f"rm -f {APPLY_LOG}")

        original_hostname = m.execute("hostnamectl --static").strip()

        self.login_and_go("/system-onboarding", user="onboarding", password="", superuser=False, tls=True)
        b.wait_visible("#networkStep")
        b.wait_visible(IFACE_TABLE)

        row_sel = iface_row_selector(b, IFACE_TABLE, self.setup_iface)
        iface_radio = f"{row_sel} input[type='radio']"
        if not b.is_present(f"{iface_radio}:checked"):
            b.click(iface_radio)

        wait_next_enabled(b)
        click_button_text(b, "Next")
        b.wait_visible("#networkServicesStep")
        click_button_text(b, "Next")
        complete_enrollment_step(b)
        b.wait_visible("#labelsStep")
        b.wait_visible("#hostname-input")
        b.set_input_text("#hostname-input", "rollback-test-host")
        click_button_text(b, "Next")
        b.wait_visible("#reviewStep")

        b.wait_in_text(
            "#review-singlenic-warning",
            "Connection will be interrupted"
        )

        b.click("#wizard-next-btn")
        b.wait_in_text("#progressStep", "Apply")

        with b.wait_timeout(120):
            b.wait_in_text(
                "#apply-singlenic-alert",
                "Onboarding continues in the background",
            )

        # The background script runs check-connectivity.sh in a loop
        # within the connectivity timeout budget (1s) before rolling back.
        deadline = time.time() + 60
        rollback_confirmed = False
        while time.time() < deadline:
            try:
                log_contents = m.execute(f"cat {APPLY_LOG} 2>/dev/null || true")
                if "Rollback complete" in log_contents:
                    rollback_confirmed = True
                    break
            except Exception:
                pass
            time.sleep(3)

        self.assertTrue(
            rollback_confirmed,
            f"Rollback did not complete within timeout. Log:\n"
            f"{m.execute(f'cat {APPLY_LOG} 2>/dev/null || echo no-log')}"
        )

        log_contents = m.execute(f"cat {APPLY_LOG}")
        self.assertIn("Connectivity not available after", log_contents)
        self.assertIn("Rolling back", log_contents)

        # Verify the onboarding NM profile was cleaned up
        nm_connections = m.execute("nmcli -t -f NAME connection show")
        self.assertNotIn(
            f"flightctl-onboarding-{self.setup_iface}",
            nm_connections
        )

        # Verify hostname was restored
        restored_hostname = m.execute("hostnamectl --static").strip()
        self.assertEqual(restored_hostname, original_hostname)


TCP_NS = "tcp_test_ns"
TCP_VETH_HOST = "veth-tcp0"
TCP_VETH_NS = "veth-tcp1"
TCP_NS_IP4 = "10.200.0.1"
TCP_HOST_IP4 = "10.200.0.2"
TCP_NS_IP6 = "fd00:200::1"
TCP_HOST_IP6 = "fd00:200::2"
TCP_NETMASK = "255.255.255.0"
TCP_PORT = 443


class TestApplyTcpFallback(OnboardingMachineCase):
    """Test that connectivity succeeds via TCP fallback when ICMP is blocked.

    Creates a veth pair with one end in a network namespace. The namespace
    side blocks all ICMP traffic and runs a TCP listener. The wizard
    configures a static IP on the host-side veth, and the connectivity
    check should fail ping but succeed via TCP connect fallback.
    """

    def setUp(self):
        super().setUp()
        m = self.machine

        m.execute(f"ip link add {TCP_VETH_HOST} type veth peer name {TCP_VETH_NS}")
        m.execute(f"ip netns add {TCP_NS}")
        m.execute(f"ip link set {TCP_VETH_NS} netns {TCP_NS}")

        m.execute(f"ip netns exec {TCP_NS} ip link set lo up")
        m.execute(f"ip netns exec {TCP_NS} ip link set {TCP_VETH_NS} up")
        m.execute(
            f"ip netns exec {TCP_NS} ip addr add"
            f" {TCP_NS_IP4}/24 dev {TCP_VETH_NS}"
        )
        m.execute(
            f"ip netns exec {TCP_NS} ip -6 addr add"
            f" {TCP_NS_IP6}/64 dev {TCP_VETH_NS}"
        )

        # Block ICMP (v4 + v6 echo-request) via nft — works on all target
        # distros regardless of whether iptables/ip6tables extensions are
        # available in the kernel.
        m.execute(
            f"ip netns exec {TCP_NS} nft '"
            f"add table inet icmp_block; "
            f"add chain inet icmp_block input"
            f" {{ type filter hook input priority 0; policy accept; }}; "
            f"add rule inet icmp_block input meta l4proto icmp drop; "
            f"add rule inet icmp_block input icmpv6 type echo-request drop'"
        )

        # Start a TCP listener (fully detached so m.execute doesn't block)
        m.execute(
            f"ip netns exec {TCP_NS}"
            f" python3 -c 'import socket,time; "
            f"s=socket.socket(socket.AF_INET6,socket.SOCK_STREAM); "
            f"s.setsockopt(socket.SOL_SOCKET,socket.SO_REUSEADDR,1); "
            f"s.setsockopt(socket.IPPROTO_IPV6,socket.IPV6_V6ONLY,0); "
            f"s.bind((\"::\",{TCP_PORT})); "
            f"s.listen(1); "
            f"time.sleep(600)' </dev/null >/dev/null 2>&1 &"
        )

        m.execute(f"ip link set {TCP_VETH_HOST} up")
        m.execute(f"nmcli device set {TCP_VETH_HOST} managed yes")
        m.execute("udevadm settle")

        deadline = time.time() + 15
        while time.time() < deadline:
            state = m.execute(
                f"nmcli -g GENERAL.STATE device show {TCP_VETH_HOST}"
                " 2>/dev/null || echo waiting"
            ).strip()
            if state and "waiting" not in state:
                break
            time.sleep(1)

        self.addCleanup(self._cleanup_tcp)

    def _cleanup_tcp(self):
        m = self.machine
        try:
            m.execute(
                "nmcli -t -f NAME connection show"
                " | grep flightctl-onboarding"
                " | xargs -r -n1 nmcli con delete 2>/dev/null || true"
            )
        except Exception:
            pass
        try:
            m.execute(
                f"ip netns pids {TCP_NS} 2>/dev/null"
                " | xargs -r kill 2>/dev/null || true"
            )
            time.sleep(1)
            m.execute(f"ip netns delete {TCP_NS} 2>/dev/null || true")
        except Exception:
            pass
        try:
            m.execute(f"ip link del {TCP_VETH_HOST} 2>/dev/null || true")
        except Exception:
            pass

    def testTcpFallbackIpv4(self):
