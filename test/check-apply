        click_button_text(b, "Next")
        complete_enrollment_step(b)

        b.wait_visible("#labelsStep")
        b.wait_visible("#hostname-input")
        b.set_input_text("#hostname-input", "tcp-fallback-v4")
        click_button_text(b, "Next")

        b.wait_visible("#reviewStep")
        b.click("#wizard-next-btn")
        b.wait_in_text("#progressStep", "Apply")

        b.wait_in_text("#apply-steps", "Testing network connectivity")
        with b.wait_timeout(120):
            b.wait_in_text(
                "#apply-success-alert",
                "Configuration completed successfully",
            )

        # Expand connectivity step details and verify TCP fallback was used
        b.click("#enrollment-progress-step-test-connectivity-toggle")
        b.wait_in_text(
            "#enrollment-progress-step-test-connectivity-content",
